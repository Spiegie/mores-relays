{
  "name": "morse-chat",
  "version": "0.1.0",
  "description": "Morse Chat - Client and Server (Single Server Edition)",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "serve": "tsx morse-relais.ts server --port 7002 --name nix-server",
    "server:dev": "tsx morse-relais.ts server --port 7002 --name dev-server"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
