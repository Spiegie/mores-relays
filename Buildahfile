#!/usr/bin/env bash
# Buildah script for Morse Chat
# Builds a production-ready Docker/OCI image

# Configuration
IMAGE_NAME="federated-morse-chat"
IMAGE_TAG="latest"
REGISTRY=""

# Use Node.js 20 LTS as base
BASE_IMAGE="docker.io/library/node:20-alpine"

# Port exposed by the container
SERVER_PORT=7002

# Set this to your registry if pushing
# REGISTRY="ghcr.io/yourusername"

# ============================================================================
# Build the image
# ============================================================================

echo "Building ${IMAGE_NAME}:${IMAGE_TAG}..."

# Create a new container from the base image
container=$(buildah from --name morse-build ${BASE_IMAGE})

# Set up build environment
buildah config --label maintainer="Morse Chat" \
  --label description="Morse Chat Server and Client" \
  --label version="0.1.0" \
  ${container}

# Install build dependencies
buildah run ${container} apk add --no-cache git python3 make g++

# Create app directory
buildah run ${container} mkdir -p /app
app_mount=$(buildah mount ${container})

# Copy application files (exclude local deps, VCS data, build output, secrets)
mkdir -p "${app_mount}/app"
rsync -a --exclude node_modules --exclude .git --exclude .jj \
  --exclude dist --exclude ssl --exclude .env ./ "${app_mount}/app/"

# Install dependencies
buildah run ${container} sh -c "cd /app && npm install"

# Build the React client for production
buildah run ${container} sh -c "cd /app && npm run build"

# Clean up the container
buildah run ${container} sh -c "cd /app && npm cache clean --force"

# Remove build dependencies
buildah run ${container} apk del git python3 make g++

# Install tsx for running the TypeScript server at runtime
buildah run ${container} npm install -g tsx

# Run as non-root user for security
buildah run ${container} adduser -D -s /bin/sh morseuser
buildah run ${container} chown -R morseuser:morseuser /app
buildah config --user morseuser ${container}

# Set working directory
buildah config --workingdir /app ${container}

# Expose port
buildah config --port ${SERVER_PORT} ${container}

# Set environment variables
buildah config --env NODE_ENV=production ${container}

# Set entrypoint to start the server
buildah config --entrypoint '["tsx", "morse-relais.ts", "server", "--port", "7002", "--name", "docker-server"]' \
  ${container}

# Commit the container to an image
buildah commit ${container} ${IMAGE_NAME}:${IMAGE_TAG}

# Clean up
buildah umount ${container}
buildah rm ${container}

echo "Build complete: ${IMAGE_NAME}:${IMAGE_TAG}"

# ============================================================================
# Push to registry (optional)
# ============================================================================

if [ -n "${REGISTRY}" ]; then
  FULL_IMAGE="${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
  echo "Pushing to ${FULL_IMAGE}..."
  buildah push ${IMAGE_NAME}:${IMAGE_TAG} docker://${FULL_IMAGE}
  echo "Pushed successfully!"
fi

echo ""
echo "To run the container:"
echo "  podman run -d --name morse-app -p 7002:7002 ${IMAGE_NAME}:${IMAGE_TAG}"
echo ""
